.claude/worktrees/
.claude/settings.local.json
.claude/launch.json

# Dependencies — never commit node_modules (native binaries are OS-specific)
node_modules/
backend/node_modules/
web/node_modules/

# Build output
web/dist/

# Local env
.env
backend/.env

# Local SQLite database (содержит PII — никогда не коммитить)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.db-journal

# Local-disk upload fallback (used when S3_* env vars aren't set) — user content
backend/uploads/

# Скиллы агента (docs/SKILLS.md). Внешний набор — реальные файлы в .agents/skills/,
# они коммитятся. .claude/skills/ — локальный слой симлинков, созданный
# установщиком: при core.symlinks=false (Windows) git развернул бы их в дубли
# файлов, поэтому содержимое игнорируется и восстанавливается командой
# `npx skills experimental_install` по skills-lock.json. Исключение — собственный
# скилл проекта: он лежит там обычным файлом и должен быть в репозитории.
.claude/skills/*
!.claude/skills/blizkie-migration/
